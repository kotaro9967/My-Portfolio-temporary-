---
import Section from './Section.astro';
import { contact, site } from '../data/site';

// .env に PUBLIC_FORM_ENDPOINT を設定すると、その URL へ POST します。
// 未設定の場合はメーラーを起動するフォールバックが動きます。
const formEndpoint = import.meta.env.PUBLIC_FORM_ENDPOINT ?? '';
---

<Section
  id="contact"
  number="05"
  label="CONTACT"
  title={["Let's Work", 'Together']}
  titleClass="contact__title"
>
  <Fragment slot="intro">
    <p class="section__lead">{contact.lead}</p>
    <img class="contact__illust" src="/assets/illust_pen_nib.png" alt="" width="120" loading="lazy" />
  </Fragment>

  <div class="contact__panels">
    <form
      class="card contact__form"
      data-contact-form
      data-endpoint={formEndpoint}
      data-mailto={site.email}
      method="post"
      action={formEndpoint || `mailto:${site.email}`}
    >
      <div class="contact__row">
        <label class="visually-hidden" for="contact-name">お名前</label>
        <input id="contact-name" name="name" type="text" placeholder="お名前" required autocomplete="name" />

        <label class="visually-hidden" for="contact-email">メールアドレス</label>
        <input id="contact-email" name="email" type="email" placeholder="メールアドレス" required autocomplete="email" />
      </div>

      <label class="visually-hidden" for="contact-message">メッセージ</label>
      <textarea id="contact-message" name="message" rows="5" placeholder="メッセージをご入力ください" required></textarea>

      <button class="contact__submit" type="submit">
        <span data-submit-label>SEND MESSAGE</span>
        <span class="arrow arrow--deep" aria-hidden="true"></span>
      </button>

      <p class="contact__status" data-form-status role="status" hidden></p>
    </form>

    <div class="card contact__links">
      {
        contact.links.map((link) => (
          <a class="contact__link" href={link.href}>
            <img src={`/assets/${link.icon}`} alt="" width="24" height="24" loading="lazy" />
            {link.label}
          </a>
        ))
      }
    </div>
  </div>
</Section>

<script>
  const form = document.querySelector<HTMLFormElement>('[data-contact-form]');
  const label = form?.querySelector<HTMLElement>('[data-submit-label]');
  const status = form?.querySelector<HTMLElement>('[data-form-status]');

  const show = (message: string) => {
    if (!status) return;
    status.textContent = message;
    status.hidden = false;
  };

  form?.addEventListener('submit', async (event) => {
    if (!form.reportValidity()) return;
    event.preventDefault();

    const endpoint = form.dataset.endpoint;
    const data = new FormData(form);

    // 送信先が未設定のときはメーラーを起動
    if (!endpoint) {
      const body = [
        `お名前: ${data.get('name')}`,
        `メールアドレス: ${data.get('email')}`,
        '',
        String(data.get('message') ?? ''),
      ].join('\n');
      window.location.href =
        `mailto:${form.dataset.mailto}` +
        `?subject=${encodeURIComponent('ポートフォリオサイトからのお問い合わせ')}` +
        `&body=${encodeURIComponent(body)}`;
      show('メールソフトを開きました。内容をご確認のうえ送信してください。');
      return;
    }

    if (label) label.textContent = 'SENDING...';

    try {
      const response = await fetch(endpoint, {
        method: 'POST',
        body: data,
        headers: { Accept: 'application/json' },
      });
      if (!response.ok) throw new Error(String(response.status));
      form.reset();
      if (label) label.textContent = 'THANK YOU';
      show('お問い合わせを受け付けました。3営業日以内にご返信いたします。');
    } catch {
      if (label) label.textContent = 'SEND MESSAGE';
      show(`送信できませんでした。お手数ですが ${form.dataset.mailto} 宛にご連絡ください。`);
    }
  });
</script>
