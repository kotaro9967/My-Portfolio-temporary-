<canvas class="dot-field" data-dot-field aria-hidden="true"></canvas>

<script>
  const canvas = document.querySelector<HTMLCanvasElement>('[data-dot-field]');
  const context = canvas?.getContext('2d');
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (canvas && context) {
    const colors = [
      [79, 90, 199], [99, 102, 241], [110, 121, 220], [124, 134, 232],
      [139, 92, 246], [150, 130, 235], [160, 150, 235], [106, 90, 224],
    ];
    let width = 0;
    let height = 0;
    let scrollY = window.scrollY;
    let targetScroll = scrollY;
    let particles: Array<{ x: number; y: number; r: number; depth: number; color: number[]; phase: number; speed: number }> = [];

    const build = () => {
      const ratio = Math.min(2, window.devicePixelRatio || 1);
      width = window.innerWidth;
      height = window.innerHeight;
      canvas.width = width * ratio;
      canvas.height = height * ratio;
      canvas.style.width = `${width}px`;
      canvas.style.height = `${height}px`;
      context.setTransform(ratio, 0, 0, ratio, 0, 0);
      const count = Math.max(28, Math.min(70, Math.round(width / 18)));
      particles = Array.from({ length: count }, (_, index) => {
        const depth = 0.18 + Math.random() * 0.82;
        return {
          x: Math.random() * width,
          y: Math.random() * (height + 300) - 150,
          r: 0.9 + Math.random() * 1.7 + depth * 1.9,
          depth,
          color: colors[index % colors.length],
          phase: Math.random() * Math.PI * 2,
          speed: 0.00016 + Math.random() * 0.00014,
        };
      });
    };

    const draw = (time = 0) => {
      scrollY += (targetScroll - scrollY) * 0.06;
      context.clearRect(0, 0, width, height);
      context.globalCompositeOperation = 'lighter';
      const fade = 1 - Math.min(1, Math.max(0, (scrollY - height * 0.55) / (height * 0.7))) * 0.72;
      for (const particle of particles) {
        const driftX = reduced ? 0 : Math.sin(time * particle.speed + particle.phase) * (22 + particle.depth * 42);
        const rawY = particle.y - scrollY * particle.depth * 0.12;
        const y = ((rawY + 150) % (height + 300) + (height + 300)) % (height + 300) - 150;
        const glow = particle.r * (3.4 + particle.depth * 3.6);
        const gradient = context.createRadialGradient(particle.x + driftX, y, 0, particle.x + driftX, y, glow);
        const [r, g, b] = particle.color;
        gradient.addColorStop(0, `rgba(${r},${g},${b},${0.25 * fade})`);
        gradient.addColorStop(0.25, `rgba(${r},${g},${b},${0.12 * fade})`);
        gradient.addColorStop(1, `rgba(${r},${g},${b},0)`);
        context.fillStyle = gradient;
        context.beginPath();
        context.arc(particle.x + driftX, y, glow, 0, Math.PI * 2);
        context.fill();
      }
      context.globalCompositeOperation = 'source-over';
      if (!reduced) requestAnimationFrame(draw);
    };

    build();
    draw();
    window.addEventListener('scroll', () => { targetScroll = window.scrollY; }, { passive: true });
    window.addEventListener('resize', build);
  }
</script>
