---
import { getCollection } from 'astro:content';
import PageShell from '../../components/PageShell.astro';
import PageHead from '../../components/PageHead.astro';
import WorkCard from '../../components/WorkCard.astro';
import { site, works } from '../../data/site';

const items = (await getCollection('works', ({ data }) => !data.draft)).sort(
  (a, b) => a.data.order - b.data.order
);
---

<PageShell title={`参考サンプル（実案件ではありません） | ${site.name}`} description={works.lead}>
  <PageHead eyebrow="SAMPLES" title="参考サンプル" lead={works.lead} />

  <div class="archive" data-reveal>
    <p class="archive__count">{items.length} SAMPLES</p>
    <div class="archive__grid">
      {items.map((entry) => <WorkCard entry={entry} />)}
    </div>
  </div>
</PageShell>
