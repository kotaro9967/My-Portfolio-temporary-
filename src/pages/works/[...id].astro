---
import { getCollection, render } from 'astro:content';
import type { GetStaticPaths } from 'astro';
import PageShell from '../../components/PageShell.astro';
import WorkCard from '../../components/WorkCard.astro';
import { site } from '../../data/site';

export const getStaticPaths = (async () => {
  const entries = await getCollection('works', ({ data }) => !data.draft && !data.externalUrl);
  return entries.map((entry) => ({ params: { id: entry.id }, props: { entry } }));
}) satisfies GetStaticPaths;

const { entry } = Astro.props;
const { title, tag, category, image, gradient, role, period, stack, summary } = entry.data;
const { Content } = await render(entry);

const others = (await getCollection('works', ({ data, id }) => !data.draft && id !== entry.id))
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 3);
---

<PageShell title={`${title} | ${site.name}`} description={summary}>
  <article class="detail">
    <p class="detail__eyebrow">WORKS / {category}</p>
    <h1 class="detail__title text-reveal">
      <span class="text-reveal__inner">{title}</span>
      <span class="text-reveal__cover" aria-hidden="true"></span>
    </h1>
    <p class="detail__summary">{summary}</p>

    <div class="detail__hero card" style={`background:${gradient}`}>
      <img src={image} alt={`${title}の制作画面`} decoding="async" />
      <span class="work-card__tag">{tag}</span>
    </div>

    <div class="detail__body">
      <div class="prose">
        <Content />
      </div>

      <dl class="detail__meta card">
        {role && (
          <div class="detail__meta-item">
            <dt>ROLE</dt>
            <dd>{role}</dd>
          </div>
        )}
        {period && (
          <div class="detail__meta-item">
            <dt>PERIOD</dt>
            <dd>{period}</dd>
          </div>
        )}
        <div class="detail__meta-item">
          <dt>CATEGORY</dt>
          <dd>{category}</dd>
        </div>
        {stack.length > 0 && (
          <div class="detail__meta-item">
            <dt>STACK</dt>
            <dd>
              <span class="chip-row">
                {stack.map((s) => <span class="chip">{s}</span>)}
              </span>
            </dd>
          </div>
        )}
      </dl>
    </div>

    <nav class="detail__more" aria-label="他の制作事例">
      <h2 class="detail__more-title">Other Works</h2>
      <div class="archive__grid">
        {others.map((other) => <WorkCard entry={other} />)}
      </div>
      <a class="ghost-btn" href="/works">
        VIEW ALL WORKS
        <span class="arrow" aria-hidden="true"></span>
      </a>
    </nav>
  </article>
</PageShell>
