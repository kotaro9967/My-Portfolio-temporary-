---
import { getCollection, render } from 'astro:content';
import type { GetStaticPaths } from 'astro';
import PageShell from '../../components/PageShell.astro';
import { site } from '../../data/site';

export const getStaticPaths = (async () => {
  const entries = await getCollection('news', ({ data }) => !data.draft);
  return entries.map((entry) => ({ params: { id: entry.id }, props: { entry } }));
}) satisfies GetStaticPaths;

const { entry } = Astro.props;
const { title, date, category } = entry.data;
const { Content } = await render(entry);

const iso = date.toISOString().slice(0, 10);
const label = iso.replace(/-/g, '.');
---

<PageShell title={`${title} | ${site.name}`} description={`${label}のお知らせ「${title}」。${site.name}の活動・制作に関する情報をご案内します。`}>
  <article class="detail detail--narrow">
    <p class="detail__eyebrow">
      <time datetime={iso}>{label}</time>
      <span class={`news__cat news__cat--${category.toLowerCase()}`}>{category}</span>
    </p>
    <h1 class="detail__title text-reveal">
      <span class="text-reveal__inner">{title}</span>
      <span class="text-reveal__cover" aria-hidden="true"></span>
    </h1>

    <div class="prose">
      <Content />
    </div>

    <a class="ghost-btn" href="/news">
      VIEW ALL NEWS
      <span class="arrow" aria-hidden="true"></span>
    </a>
  </article>
</PageShell>
