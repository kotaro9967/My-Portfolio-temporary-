---
import PageShell from '../components/PageShell.astro';
import PageCurl from '../components/page-curl/PageCurl.astro';
import Hero from '../components/Hero.astro';
import HeroMarquee from '../components/HeroMarquee.astro';
import Intro from '../components/Intro.astro';
import Profile from '../components/Profile.astro';
import Skills from '../components/Skills.astro';
import Works from '../components/Works.astro';
import News from '../components/News.astro';
import Contact from '../components/Contact.astro';
---

<style is:global data-portfolio-particles-style>
body{isolation:isolate}
canvas[aria-hidden="true"][style*="position: fixed"]{visibility:hidden!important}
#portfolio-particle-bg{position:fixed;inset:0;z-index:0;pointer-events:none;opacity:0;transition:opacity .8s ease;background:#f4f5fc}
#portfolio-particle-bg iframe{display:block;width:100%;height:100%;border:0;pointer-events:none}
body.portfolio-particles-visible #portfolio-particle-bg{opacity:1}
body.portfolio-particles-visible main{position:relative;z-index:1;background:transparent}
body.portfolio-particles-visible main :is(h1,h2,h3,p,div:has(> .mw-line)){position:relative}
body.portfolio-particles-visible main :is(h1,h2,h3,p,div:has(> .mw-line))::before{
 content:"";position:absolute;inset:-18px -28px;z-index:-1;pointer-events:none;background:transparent;
 backdrop-filter:blur(5px);-webkit-backdrop-filter:blur(5px);
 -webkit-mask-image:radial-gradient(ellipse at center,#000 25%,rgba(0,0,0,.75) 50%,transparent 74%);
 mask-image:radial-gradient(ellipse at center,#000 25%,rgba(0,0,0,.75) 50%,transparent 74%)
}
body.portfolio-particles-visible main::after{
 content:"";position:absolute;top:var(--profile-blur-start,100vh);bottom:0;left:var(--particle-viewport-left,0);right:auto;width:var(--particle-viewport-width,100%);z-index:-1;pointer-events:none;background:transparent;
 backdrop-filter:blur(10px);-webkit-backdrop-filter:blur(10px);
 -webkit-mask-image:linear-gradient(to bottom,transparent 0,#000 110px,#000 calc(100% - 80px),transparent 100%);
 mask-image:linear-gradient(to bottom,transparent 0,#000 110px,#000 calc(100% - 80px),transparent 100%)
}
body.portfolio-particles-visible main>section~section :is(h1,h2,h3,p,div:has(> .mw-line))::before{content:none}
body.portfolio-particles-visible .marquee-wrap{width:var(--particle-viewport-width,100%)!important;margin-left:var(--particle-viewport-left,0)!important;margin-right:0!important}
@media(prefers-reduced-motion:reduce){#portfolio-particle-bg{transition:none}}
</style>

<PageShell>
  <PageCurl>
    <Hero />
  </PageCurl>
  <Intro />
  <HeroMarquee />
  <Profile />
  <Skills />
  <Works />
  <News />
  <Contact />
</PageShell>

<script is:inline src={`${import.meta.env.BASE_URL.replace(/\/$/, "")}/assets/portfolio-particles.js`} defer></script>
