# 問い合わせフォームの送信先（Formspree / Basin / 自前APIなど）
# 未設定の場合はメーラー起動にフォールバックします
PUBLIC_FORM_ENDPOINT=

# microCMS（Works / News / Articles の配信元）
# サービスドメインは https://XXXX.microcms.io の XXXX の部分
MICROCMS_SERVICE_DOMAIN=e0zqcccmnl
MICROCMS_API_KEY=

# AI記事生成（ローカル実行 / CI専用。ブラウザへ公開しないこと）
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# Team以上でキーを分離できる場合だけ設定。Hobbyでは空欄でOK
# 空欄時はMICROCMS_API_KEYを記事投稿にも使用します
MICROCMS_WRITE_API_KEY=
MICROCMS_ARTICLES_ENDPOINT=articles

# Netlify Build Hookはローカル.envではなく、GitHub ActionsのSecretに設定します
# Secret名: NETLIFY_BUILD_HOOK
